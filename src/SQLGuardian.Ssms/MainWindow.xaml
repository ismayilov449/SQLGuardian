<Window x:Class="SQLGuardian.Ssms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLGuardian"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="920"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel Margin="16">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="SQLGuardian" FontSize="22" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#57606A"
                     Text="Connect to SQL Server, then scan the database or analyze scripts."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Export report…" Padding="12,6" Click="OnExportMarkdown"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer summary -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SummaryText" Text="No analysis yet."/>
        <TextBlock Grid.Column="1" x:Name="ConfigText" Text="Config: (defaults)"/>
        <TextBlock Grid.Column="2" x:Name="SuggestionText" TextWrapping="Wrap"
                   Foreground="#57606A" Text="Select a finding to see the suggestion."/>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="300"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: connection + actions -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="SQL Server" FontWeight="SemiBold" FontSize="15"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Margin="0,4,0,12" Foreground="#57606A" TextWrapping="Wrap"
                         Text="Loads schema and row counts only — never table data."/>

              <TextBlock Text="Server" Foreground="#57606A"/>
              <TextBox x:Name="ServerBox" Margin="0,4,0,10" Padding="8,6" Text="."/>

              <TextBlock Text="Database" Foreground="#57606A"/>
              <TextBox x:Name="DatabaseBox" Margin="0,4,0,10" Padding="8,6"/>

              <CheckBox x:Name="WindowsAuthBox" Margin="0,0,0,10" IsChecked="True"
                        Content="Windows authentication"
                        Checked="OnAuthModeChanged" Unchecked="OnAuthModeChanged"/>

              <StackPanel x:Name="SqlAuthPanel" Visibility="Collapsed">
                <TextBlock Text="User name" Foreground="#57606A"/>
                <TextBox x:Name="UserBox" Margin="0,4,0,10" Padding="8,6"/>
                <TextBlock Text="Password" Foreground="#57606A"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10" Padding="8,6"/>
                <CheckBox x:Name="RememberPasswordBox" Margin="0,0,0,10"
                          Content="Remember password on this PC"/>
              </StackPanel>

              <CheckBox x:Name="TrustCertBox" IsChecked="True"
                        Content="Trust server certificate"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="What do you want to do?" FontWeight="SemiBold" FontSize="15"
                         Foreground="{StaticResource TextBrush}"/>

              <Button x:Name="CatalogButton" Margin="0,12,0,0" Padding="12,10"
                      HorizontalContentAlignment="Left" Click="OnCatalogScan"
                      Background="{StaticResource AccentBrush}" Foreground="White">
                <StackPanel>
                  <TextBlock Text="Scan database" FontWeight="SemiBold"/>
                  <TextBlock Text="Fast FK-index scan (skips column metadata)"
                             FontSize="12" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>

              <CheckBox x:Name="ForceRefreshBox" Margin="0,8,0,0"
                        Content="Force refresh schema (ignore cache)"/>

              <Button Margin="0,8,0,0" Padding="12,10" HorizontalContentAlignment="Left"
                      Click="OnAnalyzeFile">
                <StackPanel>
                  <TextBlock Text="Analyze SQL file(s)…" FontWeight="SemiBold"/>
                  <TextBlock Text="Script rules + schema tips when connected"
                             FontSize="12" Foreground="#57606A" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>

              <Button Margin="0,8,0,0" Padding="12,10" HorizontalContentAlignment="Left"
                      Click="OnAnalyzeFolder">
                <StackPanel>
                  <TextBlock Text="Analyze script folder…" FontWeight="SemiBold"/>
                  <TextBlock Text="e.g. scripts exported from Object Explorer"
                             FontSize="12" Foreground="#57606A" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>

              <Button x:Name="ReanalyzeButton" Margin="0,8,0,0" Padding="12,8"
                      Content="Re-run last analysis" Click="OnReanalyze" IsEnabled="False"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TargetText" Foreground="#57606A" TextWrapping="Wrap"
                     Text="No scripts selected yet."/>
        </StackPanel>
      </ScrollViewer>

      <!-- Right: findings + recommended SQL -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="0">
          <DataGrid x:Name="IssuesGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    RowHeaderWidth="0"
                    BorderThickness="0"
                    SelectionChanged="OnIssueSelected"
                    MouseDoubleClick="OnIssueDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
              <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="100"/>
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="140"/>
              <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="55"/>
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RecommendationTitle" Text="Recommended SQL"
                         FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBrush}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy" Padding="12,4" Margin="0,0,8,0" Click="OnCopyRecommendation"/>
                <Button Content="Export .sql…" Padding="12,4" Click="OnExportRecommendedSql"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="RecommendationBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     Text="Select a finding or run analysis to see copy-paste SQL fixes."/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
