<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <!--
    SSMS does not reliably show nested Tools → SQLGuardian submenus.
    Flat Tools items (group parented to IDM_VS_MENU_TOOLS) match working VS/SSMS samples.
  -->
  <Commands package="guidSQLGuardianPackage">
    <Groups>
      <Group guid="guidSQLGuardianCmdSet" id="SQLGuardianToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSQLGuardianCmdSet" id="AnalyzeActiveDocumentCommand" priority="0x0100" type="Button">
        <Parent guid="guidSQLGuardianCmdSet" id="SQLGuardianToolsGroup"/>
        <Strings>
          <ButtonText>SQLGuardian — Analyze Active Script (Error List)</ButtonText>
          <CommandName>SQLGuardian.AnalyzeActiveScript</CommandName>
          <MenuText>SQLGuardian — Analyze Active Script (Error List)</MenuText>
        </Strings>
      </Button>
      <Button guid="guidSQLGuardianCmdSet" id="ClearErrorListCommand" priority="0x0200" type="Button">
        <Parent guid="guidSQLGuardianCmdSet" id="SQLGuardianToolsGroup"/>
        <Strings>
          <ButtonText>SQLGuardian — Clear Findings</ButtonText>
          <CommandName>SQLGuardian.ClearFindings</CommandName>
          <MenuText>SQLGuardian — Clear Findings</MenuText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <!-- Ctrl+Shift+G — Analyze active script into Error List -->
    <KeyBinding guid="guidSQLGuardianCmdSet" id="AnalyzeActiveDocumentCommand"
                editor="guidVSStd97" key1="G" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSQLGuardianPackage" value="{a3f7c2d1-8e4b-4f9a-9c1e-2b6d0a5e7f31}" />
    <GuidSymbol name="guidSQLGuardianCmdSet" value="{b8e1d4a2-5c7f-4e3b-9a0d-6f2c1b8e4d90}">
      <IDSymbol name="SQLGuardianToolsGroup" value="0x1200" />
      <IDSymbol name="AnalyzeActiveDocumentCommand" value="0x0100" />
      <IDSymbol name="ClearErrorListCommand" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
